# MerQato Workstation edge-routing example.
#
# This mirrors the live production topology as of 20 Nov 2026; it is a source
# snapshot, not an instruction to change live routing. The Workstation app and
# the legacy Homepage dashboard run on the same host. Keep the password prompt
# on home.merqato.digital and leave Cloudflare Access in front of work.

home.merqato.digital {
	basic_auth {
		david <bcrypt-hash>
	}
	handle_path /files/* {
		reverse_proxy http://host.docker.internal:3004
	}
	handle_path /hub/* {
		reverse_proxy http://host.docker.internal:3010
	}
	reverse_proxy http://host.docker.internal:3005
	encode gzip
}

work.merqato.digital {
	handle_path /files/* {
		reverse_proxy http://host.docker.internal:3004
	}
	handle_path /hub/* {
		reverse_proxy http://host.docker.internal:3010
	}
	reverse_proxy http://host.docker.internal:3003
	encode gzip
}

dash.merqato.digital {
	redir https://home.merqato.digital{uri} permanent
}
